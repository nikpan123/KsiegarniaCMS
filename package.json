{
  "name": "bookshop_retail",
  "version": "1.0.0",
  "description": "Testy panelu Sylius dla KsiegarniaCMS",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:list": "playwright test --list",
    "test:ui": "playwright test --ui",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "start": "node dashboard/server.mjs",
    "test:unit": "node --test dashboard/*.test.mjs",
    "test:views": "node scripts/run-views.mjs",
    "test:views:assets": "node scripts/run-views.mjs --assets",
    "test:checks": "playwright test --config=playwright.checks.config.ts",
    "test:debugger": "node --test dashboard/debugger.test.mjs dashboard/debugger-browser.check.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "1.51.0",
    "@types/node": "^22.10.1",
    "typescript": "5.8.2"
  },
  "dependencies": {
    "@types/dotenv": "^6.1.1",
    "dotenv": "^16.4.7"
  }
}
